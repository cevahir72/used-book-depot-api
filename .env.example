# Production Environment Variables
# Copy this file to .env and fill in your values

# Port the server will listen on (for local development)
# In production (Vercel), this is automatically handled
PORT=3000

# Database Configuration - Option 1: Connection String (Recommended for Vercel/Neon)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# Database Configuration - Option 2: Individual Parameters
DB_HOST=localhost
DB_PORT=5432
DB_NAME=used_book_depot
DB_USER=postgres
DB_PASSWORD=your_password_here

# Node Environment
NODE_ENV=production